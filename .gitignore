# Ignore all files by default
*

# Do not ignore directories so Git can traverse them
!*/

# Whitelist explicit text configurations and source code extensions
!.gitignore
!.gitmodules
!Makefile
!*.toml
!*.md
!*.png
!*.scss
!*.jpeg
!*.jpg
!*.webp
!*.html
!*.yml
!*.js
!*.xml
!*.woff2
# story videos only; keep other .mp4s out of the repo
!static/stories/*.mp4

!*Brian_Obot_Resume.pdf
!*og-default.jpg
!*robots.txt
!*llms.txt

CLAUDE.md
current_feature.md